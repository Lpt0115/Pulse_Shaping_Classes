	keywords = {FOS: Physical sciences, Quantum Physics (quant-ph)},
	file = {PDF:C\:\\Users\\phili\\Zotero\\storage\\ABBEBDMA\\Yang et al. - 2026 - Mechanical Resonator-based Quantum Computing.pdf:application/pdf},
}

