	note = {arXiv:2602.05806 [quant-ph]},
	keywords = {Quantum Physics},
	file = {Full Text PDF:C\:\\Users\\phili\\Zotero\\storage\\U8PRJWE8\\Kerschbaum et al. - 2026 - Assessing the Sensitivity of Niobium- and Tantalum-Based Superconducting Qubits to Infrared Radiatio.pdf:application/pdf;Snapshot:C\:\\Users\\phili\\Zotero\\storage\\4RC4QHHL\\2602.html:text/html},
