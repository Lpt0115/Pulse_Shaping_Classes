@misc{baidya_contacting_2026,
	title = {Contacting {Josephson} {Junctions} via {Airbridges} in {Superconducting} {Circuits}},
	url = {http://arxiv.org/abs/2606.06951},
	doi = {10.48550/arXiv.2606.06951},
	abstract = {Superconducting circuit devices require electrical interconnects between different circuit elements on the chip, for which conventional device architectures use a combination of two structural elements: {\textbackslash}textit\{airbridges\} to connect non-adjacent elements in the base layer, and {\textbackslash}textit\{bandages\} to connect the electrodes forming the Josephson junctions to the base layer. Bandages introduce unwanted parasitic material interfaces and increase the manufacturing complexity. Here, we overcome the limitations imposed by {\textbackslash}emph\{bandages\} by establishing {\textbackslash}textit\{all\} electrical interconnects with airbridges of varying size fabricated in a single step. The airbridges show a high yield and mechanical stability over a wide range of sizes from \$0.5{\textbackslash},μ{\textbackslash}mathrm\{m\}\$ to \$4{\textbackslash},μ{\textbackslash}mathrm\{m\}\$ in width and from \$5{\textbackslash},μ{\textbackslash}mathrm\{m\}\$ to \$40{\textbackslash},μ{\textbackslash}mathrm\{m\}\$ in length, and show low loss when integrated in coplanar waveguide resonators and transmon qubits. Measured relaxation times up to more than \$250{\textbackslash},μ{\textbackslash}mathrm\{s\}\$ in standard transmon geometries show that the process achieves high coherence while substantially easing and accelerating device fabrication.},
	urldate = {2026-07-01},
