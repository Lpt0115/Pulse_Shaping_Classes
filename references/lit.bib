@article{tholen_measurement_2022,
	title = {Measurement and control of a superconducting quantum processor with a fully integrated radio-frequency system on a chip},
	volume = {93},
	issn = {0034-6748},
	url = {https://doi.org/10.1063/5.0101398},
	doi = {10.1063/5.0101398},
	abstract = {We describe a digital microwave platform called Presto, designed for measurement and control of multiple quantum bits (qubits) and based on the third-generation radio-frequency system on a chip. Presto uses direct digital synthesis to create signals up to 9 GHz on 16 synchronous output ports, while synchronously analyzing responses on 16 input ports. Presto has 16 DC-bias outputs, four inputs and four outputs for digital triggers or markers, and two continuous-wave outputs for synthesizing frequencies up to 15 GHz. Scaling to a large number of qubits is enabled through deterministic synchronization of multiple Presto units. A Python application programming interface configures a firmware for synthesis and analysis of pulses, coordinated by an event sequencer. The analysis integrates template matching (matched filtering) and low-latency (184–254 ns) feedback to enable a wide range of multi-qubit experiments. We demonstrate Presto’s capabilities with experiments on a sample consisting of two superconducting qubits connected via a flux-tunable coupler. We show single-shot readout and active reset of a single qubit; randomized benchmarking of single-qubit gates showing 99.972\% fidelity, limited by the coherence time of the qubit; and calibration of a two-qubit iSWAP gate.},
	number = {10},
	%urldate = {2026-08-31},
	journal = {Review of Scientific Instruments},
	author = {Tholén, Mats O. and Borgani, Riccardo and Di Carlo, Giuseppe Ruggero and Bengtsson, Andreas and Križan, Christian and Kudra, Marina and Tancredi, Giovanna and Bylander, Jonas and Delsing, Per and Gasparinetti, Simone and Haviland, David B.},
	month = oct,
	year = {2022},
	pages = {104711},
	file = {Full Text PDF:C\:\\Users\\phili\\Zotero\\storage\\UFMRTHHJ\\Tholén et al. - 2022 - Measurement and control of a superconducting quantum processor with a fully integrated radio-frequen.pdf:application/pdf;Snapshot:C\:\\Users\\phili\\Zotero\\storage\\B5JIXKDS\\5.html:text/html},
}
